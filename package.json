{
  "name": "db-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:fix": "npm run lint:code:fix && npm run lint:styles:fix",
    "lint:code": "eslint ./src",
    "lint:code:fix": "eslint ./src --fix",
    "lint:styles": "stylelint './**/*.scss'",
    "lint:styles:fix": "stylelint --fix './**/*.scss'",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "icons": "svgr --typescript --memo --icon --replace-attr-values '#fff=currentColor' --template icons/icon-template.js ./icons/svg --out-dir src/icons"
  },
  "dependencies": {
    "camelcase": "^8.0.0",
    "framer-motion": "^11.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^19.0.0",
    "react-infinite-scroll-component": "^6.1.0",
    "react-intersection-observer": "^9.13.0",
    "react-markdown": "^9.0.0",
    "react-share": "^5.1.0",
    "react-syntax-highlighter": "^15.6.0",
    "reading-time": "^1.5.0",
    "sitemap": "^8.0.0"
  },
  "devDependencies": {
    "@endemolshinegroup/cz-github": "^2.0.0",
    "@eslint/compat": "^2.0.1",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@svgr/cli": "^8.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "commitizen": "^4.3.0",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.0",
    "postcss-flexbugs-fixes": "^5.0.0",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^10.1.0",
    "prettier": "^3.4.0",
    "sass": "^1.83.0",
    "stylelint": "^16.12.0",
    "stylelint-config-prettier": "^9.0.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-order": "^6.0.0",
    "stylelint-prettier": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "config": {
    "commitizen": {
      "path": "@endemolshinegroup/cz-github"
    }
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && git cz --hook || true",
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache",
    "*.scss": "stylelint",
    "*.*": "prettier --check"
  }
}
