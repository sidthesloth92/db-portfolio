{
  "name": "db-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:fix": "npm run lint:code:fix && npm run lint:styles:fix",
    "lint:code": "eslint ./src --ext .js,.jsx,.ts,.tsx",
    "lint:code:fix": "eslint ./src --fix --ext .js,.jsx,.ts,.tsx",
    "lint:styles": "stylelint './**/*.scss'",
    "lint:styles:fix": "stylelint --fix './**/*.scss'",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "icons": "svgr --typescript --memo --icon --replace-attr-values '#fff=currentColor' --template icons/icon-template.js ./icons/svg --out-dir src/icons",
    "prepare": "husky"
  },
  "dependencies": {
    "autoprefixer": "^10.4.23",
    "camelcase": "^9.0.0",
    "framer-motion": "^12.29.0",
    "next": "^16.1.4",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^19.2.3",
    "react-infinite-scroll-component": "^6.1.1",
    "react-intersection-observer": "^10.0.2",
    "react-markdown": "^10.1.0",
    "react-share": "^5.2.2",
    "react-syntax-highlighter": "^16.1.0",
    "reading-time": "^1.5.0",
    "sitemap": "^9.0.0"
  },
  "devDependencies": {
    "@endemolshinegroup/cz-github": "^2.0.0",
    "@svgr/cli": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "commitizen": "^4.3.1",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^11.1.1",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "stylelint": "^17.0.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-order": "^7.0.1",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache",
    "*.scss": "stylelint",
    "*.*": "prettier --check"
  }
}
